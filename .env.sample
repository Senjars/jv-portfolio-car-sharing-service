### DATABASE CONFIGURATION ###
DB_URL=jdbc:mysql://localhost:3306/carsharing_db
DB_USERNAME=your_db_user_here
DB_PASSWORD=your_db_password_here

### JWT CONFIGURATION ###
# Secret should be at least 32 characters long for HS256 algorithm
JWT_SECRET=your_jwt_secret_key_min_32_chars
# Expiration time in milliseconds (e.g., 86400000 for 24 hours)
JWT_EXPIRATION=86400000

### STRIPE CONFIGURATION ###
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
APP_URL=http://localhost:8080

### TELEGRAM CONFIGURATION ###
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_USERNAME=your_telegram_bot_username_here